<!-- The scene: who is on the board and how they look. The logic is in scene.swap. -->
<Scene background="#101018">

  <!-- Player: a square moved with the arrows -->
  <Actor name="Player" x="400" y="300" w="40" h="40">
    <Rect color="#4cc9f0"/>
    <Var name="speed" value="4"/>
  </Actor>

  <!-- A coin to collect -->
  <Actor name="Coin" x="200" y="150" w="20" h="20">
    <Circle color="gold"/>
  </Actor>

  <!-- An invisible actor that stores the game state -->
  <Actor name="Game" w="0" h="0" visible="false">
    <Var name="coins" value="0"/>
  </Actor>

  <!-- The score. {Game.coins} updates live -->
  <Actor name="Score" x="20" y="20" w="0" h="0" layer="10" space="screen">
    <Text value="Coins: {Game.coins}   (SPACE = turbo)" size="24" color="white"/>
  </Actor>

  <!-- Archetype: a template for actors created during the game by SPAWN -->
  <Archetype name="Spark" w="6" h="6">
    <Circle color="gold"/>
    <Var name="life" value="30"/>
  </Archetype>

</Scene>
