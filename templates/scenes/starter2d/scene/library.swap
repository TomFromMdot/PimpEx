# Procedure library. These PROCs do not run on their own –
# the engine pastes them into scene.swap with PROC_ADD or swap.add() in Lua.

# Turbo: the player is faster for 3 seconds (180 frames), then the procedure
# removes itself from scene.swap.
PROC turbo
  SET Player.speed 8
  ADD Player.turbo 1
  IF Player.turbo > 180 : PROC_REMOVE turbo
  IF Player.turbo > 180 : SET Player.speed 4
  IF Player.turbo > 180 : SET Player.turbo 0
END
