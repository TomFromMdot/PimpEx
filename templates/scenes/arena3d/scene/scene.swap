# Scene {{SCENE}}: 3D arena logic.

PROC coins FOR @coin
  IF TOUCH SELF Player : ADD Game.coins 1
  IF TOUCH SELF Player : DESTROY SELF
END

# An enemy touched the player: one life less, back to the centre.
PROC enemies FOR @enemy
  IF TOUCH SELF Player : ADD Game.lives -1
  IF TOUCH SELF Player : SET Player.z 0
  IF TOUCH SELF Player : SET Player.x 0
END

PROC game_over
  IF NOT EXISTS @coin : SET Hud.Text.value "All coins collected! Well done!"
  IF Game.lives <= 0  : SCENE {{SCENE}}
END
