# Scena {{SCENE}}: logika areny 3D.

PROC monety FOR @coin
  IF TOUCH SELF Player : ADD Game.coins 1
  IF TOUCH SELF Player : DESTROY SELF
END

# Wróg dotknął gracza: minus życie, gracz wraca na środek.
PROC wrogowie FOR @enemy
  IF TOUCH SELF Player : ADD Game.lives -1
  IF TOUCH SELF Player : SET Player.z 0
  IF TOUCH SELF Player : SET Player.x 0
END

PROC koniec
  IF NOT EXISTS @coin : SET Hud.Text.value "Wszystkie monety! Brawo!"
  IF Game.lives <= 0  : SCENE {{SCENE}}
END
