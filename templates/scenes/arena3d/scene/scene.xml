<!-- Scena {{SCENE}}: arena 3D. W/S – przód/tył, A/D – obrót, SPACJA – skok. -->
<Scene mode="3d" background="#9fd3ff">

  <!-- Podłoga i ściany areny: solidne Collidery -->
  <Actor name="Ground" y="-0.5" w="40" h="1" d="40"><Cube color="#4f772d"/><Collider/></Actor>
  <Actor name="WallN" y="1" z="-20" w="40" h="2" d="1" tags="wall"><Cube color="#6c584c"/><Collider/></Actor>
  <Actor name="WallS" y="1" z="20" w="40" h="2" d="1" tags="wall"><Cube color="#6c584c"/><Collider/></Actor>
  <Actor name="WallW" x="-20" y="1" w="1" h="2" d="40" tags="wall"><Cube color="#6c584c"/><Collider/></Actor>
  <Actor name="WallE" x="20" y="1" w="1" h="2" d="40" tags="wall"><Cube color="#6c584c"/><Collider/></Actor>
  <Actor name="Pillar1" x="-6" y="2" z="-5" w="2" h="4" d="2"><Cylinder color="#adb5bd"/><Collider/></Actor>
  <Actor name="Pillar2" x="7" y="2" z="4" w="2" h="4" d="2"><Cylinder color="#adb5bd"/><Collider/></Actor>
  <Actor name="Crate" x="3" y="0.75" z="-8" w="1.5" h="1.5" d="1.5"><Cube color="#bc6c25"/><Collider/></Actor>

  <!-- Gracz -->
  <Actor name="Player" y="1" w="1" h="1" d="1" gravity="0.02" tags="hero">
    <Cube color="#4cc9f0"/>
    <Collider/>
    <Behavior name="move3d" speed="0.15" turn="3" jump="0.35"/>
  </Actor>

  <!-- Monety: kręcące się walce -->
  <Actor name="Coin1" x="-10" y="0.6" z="-10" w="0.8" h="0.15" d="0.8" rx="90" tags="coin">
    <Cylinder color="gold"/><Behavior name="spin" axis="ry" speed="3"/>
  </Actor>
  <Actor name="Coin2" x="12" y="0.6" z="-12" w="0.8" h="0.15" d="0.8" rx="90" tags="coin">
    <Cylinder color="gold"/><Behavior name="spin" axis="ry" speed="3"/>
  </Actor>
  <Actor name="Coin3" x="-12" y="0.6" z="12" w="0.8" h="0.15" d="0.8" rx="90" tags="coin">
    <Cylinder color="gold"/><Behavior name="spin" axis="ry" speed="3"/>
  </Actor>
  <Actor name="Coin4" x="14" y="0.6" z="14" w="0.8" h="0.15" d="0.8" rx="90" tags="coin">
    <Cylinder color="gold"/><Behavior name="spin" axis="ry" speed="3"/>
  </Actor>

  <!-- Wrogowie: kule, które gonią gracza po ziemi -->
  <Actor name="Enemy1" x="15" y="0.6" z="-15" w="1.2" tags="enemy">
    <Sphere color="#d00000"/><Behavior name="chase" target="Player" axes="xz" speed="0.04"/>
  </Actor>
  <Actor name="Enemy2" x="-15" y="0.6" z="15" w="1.2" tags="enemy">
    <Sphere color="#d00000"/><Behavior name="chase" target="Player" axes="xz" speed="0.05"/>
  </Actor>

  <Actor name="Sun" x="10" y="20" z="10"><Light kind="directional" color="white"/></Actor>
  <Actor name="Lamp" y="6"><Light kind="point" color="#ffd6a5" intensity="0.5"/></Actor>

  <Actor name="Cam"><Camera mode="follow" target="Player" distance="7" height="3.5"/></Actor>

  <Actor name="Game" w="0" h="0" visible="false">
    <Var name="coins" value="0"/>
    <Var name="lives" value="3"/>
  </Actor>
  <Actor name="Hud" x="20" y="20" w="0" h="0" space="screen">
    <Text value="Monety: {Game.coins}/4   Życia: {Game.lives}" size="24" color="black"/>
  </Actor>

</Scene>
