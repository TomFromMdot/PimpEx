# Scene {{SCENE}}: top-down game logic.

# Every coin checks whether it touches the player (FOR @coin = for each coin, SELF = this coin).
PROC coins FOR @coin
  IF TOUCH SELF Player : ADD Game.coins 1
  IF TOUCH SELF Player : DESTROY SELF
END

# The ghost caught the player: one life less, back to the start.
PROC enemies FOR @enemy
  IF TOUCH SELF Player : ADD Game.lives -1
  IF TOUCH SELF Player : SET Player.y 200
  IF TOUCH SELF Player : SET Player.x 200
END

PROC game_over
  IF NOT EXISTS @coin : SET Hud.Text.value "All coins collected! Well done!"
  IF Game.lives <= 0  : SCENE {{SCENE}}
END
