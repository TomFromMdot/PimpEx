<!-- Scena {{SCENE}}: gra z góry. Świat 1200 × 900, kamera podąża za graczem. -->
<Scene background="#1b1b2f">

  <!-- Gracz: ruch z zachowania topdown_move, Collider = nie przechodzi przez ściany -->
  <Actor name="Player" x="200" y="200" w="28" h="28" layer="5" tags="hero">
    <Rect color="#4cc9f0"/>
    <Collider/>
    <Behavior name="topdown_move" speed="4"/>
  </Actor>

  <!-- Ściany i przeszkody: solidne Collidery -->
  <Actor name="WallTop" x="600" y="0" w="1220" h="20" tags="wall"><Rect color="#3a3a5a"/><Collider/></Actor>
  <Actor name="WallBottom" x="600" y="900" w="1220" h="20" tags="wall"><Rect color="#3a3a5a"/><Collider/></Actor>
  <Actor name="WallLeft" x="0" y="450" w="20" h="920" tags="wall"><Rect color="#3a3a5a"/><Collider/></Actor>
  <Actor name="WallRight" x="1200" y="450" w="20" h="920" tags="wall"><Rect color="#3a3a5a"/><Collider/></Actor>
  <Actor name="Rock1" x="500" y="400" w="120" h="80" tags="wall"><Rect color="#5c5470"/><Collider/></Actor>
  <Actor name="Rock2" x="850" y="250" w="60" h="200" tags="wall"><Rect color="#5c5470"/><Collider/></Actor>

  <!-- Monety: tag coin – obsługuje je PROC monety FOR @coin -->
  <Actor name="Coin1" x="400" y="150" w="16" h="16" tags="coin"><Circle color="gold"/></Actor>
  <Actor name="Coin2" x="700" y="600" w="16" h="16" tags="coin"><Circle color="gold"/></Actor>
  <Actor name="Coin3" x="1050" y="120" w="16" h="16" tags="coin"><Circle color="gold"/></Actor>
  <Actor name="Coin4" x="300" y="750" w="16" h="16" tags="coin"><Circle color="gold"/></Actor>
  <Actor name="Coin5" x="1000" y="800" w="16" h="16" tags="coin"><Circle color="gold"/></Actor>

  <!-- Duch: goni gracza (zachowanie chase) -->
  <Actor name="Ghost" x="1000" y="500" w="26" h="26" tags="enemy">
    <Circle color="#f72585"/>
    <Behavior name="chase" target="Player" speed="1.3"/>
  </Actor>

  <Actor name="Game" w="0" h="0" visible="false">
    <Var name="coins" value="0"/>
    <Var name="lives" value="3"/>
  </Actor>

  <Actor name="Cam"><Camera mode="follow" target="Player"/></Actor>

  <Actor name="Hud" x="20" y="20" w="0" h="0" space="screen">
    <Text value="Monety: {Game.coins}/5   Życia: {Game.lives}" size="24" color="white"/>
  </Actor>

</Scene>
