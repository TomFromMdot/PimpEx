<!-- Scene {{SCENE}}: platformer. Gravity + solid Colliders = jumping between platforms. -->
<Scene background="#0f1a2b">

  <!-- Player: gravity pulls down, the Collider stops it on platforms -->
  <Actor name="Player" x="100" y="480" w="24" h="32" gravity="0.6" layer="5" tags="hero">
    <Rect color="#ffcc00"/>
    <Collider/>
    <Behavior name="platformer_move" speed="4" jump="11"/>
  </Actor>

  <Actor name="Ground" x="900" y="580" w="1800" h="40"><Rect color="#3a7d44"/><Collider/></Actor>
  <Actor name="P1" x="320" y="470" w="160" h="16"><Rect color="#6c757d"/><Collider/></Actor>
  <Actor name="P2" x="540" y="380" w="140" h="16"><Rect color="#6c757d"/><Collider/></Actor>
  <Actor name="P3" x="780" y="300" w="140" h="16"><Rect color="#6c757d"/><Collider/></Actor>
  <Actor name="P4" x="1040" y="390" w="160" h="16"><Rect color="#6c757d"/><Collider/></Actor>
  <!-- Moving platform: the patrol behavior on the y axis -->
  <Actor name="Lift" x="1300" y="420" w="120" h="16">
    <Rect color="#adb5bd"/>
    <Collider/>
    <Behavior name="patrol" axis="y" distance="100" speed="1"/>
  </Actor>

  <Actor name="Coin1" x="320" y="430" w="16" h="16" tags="coin"><Circle color="gold"/></Actor>
  <Actor name="Coin2" x="540" y="340" w="16" h="16" tags="coin"><Circle color="gold"/></Actor>
  <Actor name="Coin3" x="780" y="260" w="16" h="16" tags="coin"><Circle color="gold"/></Actor>
  <Actor name="Coin4" x="1300" y="250" w="16" h="16" tags="coin"><Circle color="gold"/></Actor>

  <Actor name="Flag" x="1650" y="520" w="20" h="80"><Rect color="white"/></Actor>

  <Actor name="Game" w="0" h="0" visible="false"><Var name="coins" value="0"/></Actor>
  <Actor name="Cam"><Camera mode="follow" target="Player"/></Actor>
  <Actor name="Hud" x="20" y="20" w="0" h="0" space="screen">
    <Text value="Coins: {Game.coins}   (arrows + SPACE)" size="24" color="white"/>
  </Actor>

</Scene>
