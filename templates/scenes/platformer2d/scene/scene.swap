# Scene {{SCENE}}: platformer logic.

PROC coins FOR @coin
  IF TOUCH SELF Player : ADD Game.coins 1
  IF TOUCH SELF Player : DESTROY SELF
END

# Fell off the level – back to the start.
PROC fall
  IF Player.y > 900 : SET Player.x 100
  IF Player.y > 900 : SET Player.vy 0
  IF Player.y > 900 : SET Player.y 480
END

PROC finish
  IF TOUCH Player Flag : SET Hud.Text.value "Finish! Coins: {Game.coins}"
END
