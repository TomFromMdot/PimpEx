<!-- Pauza: ESC w grze ją pokazuje (scenes/poziom1/scene.swap). Gdy jest
     widoczna, gra stoi, a kamera fps oddaje kursor, żeby dało się klikać. -->
<Gui pause="true" dim="#000000aa">
  <Panel  anchor="center" w="380" h="300" color="#2a1a10" border="#c8a04a"/>
  <Label  anchor="center" y="-95" text="PAUZA" size="48" color="#c8a04a"/>
  <Label  anchor="center" y="-50" text="Punkty: {Game.score}   Życie: {Player.Health.hp}" size="22" color="white"/>
  <Button anchor="center" y="15" text="Graj dalej" key="ESCAPE" click="GUI_HIDE pauza"
          color="#5a3a1a" hover="#7a5226"/>
  <Button anchor="center" y="90" text="Od nowa" click="SCENE poziom1"
          color="#5a3a1a" hover="#7a5226"/>
</Gui>
