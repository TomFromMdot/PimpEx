# Poziom 1 – logika sceny. Ruch, strzelanie, strażnicy, drzwi i znajdźki
# są w zachowaniach Lua (scripts/behaviors/). Tu: HUD i koniec gry.

# HUD: czerwony błysk po trafieniu, ogień z lufy, komunikaty.
PROC hud
  IF Game.hurt > 0   : SET Flash.visible 1
  IF Game.hurt > 0   : ADD Game.hurt -1
  IF Game.hurt <= 0  : SET Flash.visible 0
  IF Game.muzzle > 0 : SET Muzzle.visible 1
  IF Game.muzzle > 0 : ADD Game.muzzle -1
  IF Game.muzzle <= 0 : SET Muzzle.visible 0
  IF Game.msgt == 1  : SET Msg.Text.value ""
  IF Game.msgt > 0   : ADD Game.msgt -1
END

PROC koniec
  IF Player.Health.hp <= 0 : SCENE przegrana
  IF TOUCH Player @exit    : SCENE wygrana
END

# ESC: pauza z gui/pauza.xml (gra stoi, kursor wolny).
PROC pauza
  IF PRESSED ESCAPE : GUI_SHOW pauza
END

# Kody (klawisze 8 i 9) wklejają procedury z library.swap.
PROC kody
  IF PRESSED 9 : PROC_ADD iddqd
  IF PRESSED 8 : PROC_ADD idkfa
END
