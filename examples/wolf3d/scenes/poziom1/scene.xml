<!--
  Wolf 3D na PimpEx – poziom 1.
  Mapa to zwykły tekst: każdy znak to aktor z archetypu (legenda niżej).
  Jedna kratka = 2 × 2 metry. Zmień mapę, zapisz – gra wczyta ją na nowo.
-->
<Scene mode="3d" background="#2b2b2b">

  <!-- ===== Archetypy: z nich powstają aktorzy na mapie ===== -->

  <Archetype name="Wall" y="1" w="2" h="2" d="2">
    <Cube color="#7c7c7c"/><Collider/>
  </Archetype>
  <Archetype name="BlueWall" y="1" w="2" h="2" d="2">
    <Cube color="#34458f"/><Collider/>
  </Archetype>

  <!-- Drzwi: E otwiera (zachowanie door), wjeżdżają w sufit -->
  <Archetype name="Door" y="1" w="2" h="2" d="2" tags="door">
    <Cube color="#2f8f8f"/><Collider/>
    <Behavior name="door" stay="180"/>
  </Archetype>

  <!-- Strażnik: widzi gracza (raycast), goni go i strzela -->
  <Archetype name="Guard" y="0.7" w="0.8" h="1.4" d="0.8" vx="0" tags="guard">
    <Cylinder color="#8b6f47"/><Collider/>
    <Health hp="25" max="25"/>
    <Behavior name="guard" speed="0.05" range="16" damage="10"/>
  </Archetype>
  <Archetype name="DeadGuard" y="0.05" w="1.2" h="0.1" d="0.7">
    <Cube color="#5a1a1a"/>
  </Archetype>

  <!-- Znajdźki -->
  <Archetype name="Medkit" y="0.2" w="0.6" h="0.3" d="0.6" tags="pickup">
    <Cube color="white"/><Behavior name="pickup" kind="health" amount="25"/>
  </Archetype>
  <Archetype name="AmmoBox" y="0.15" w="0.5" h="0.25" d="0.3" tags="pickup">
    <Cube color="#c8a040"/><Behavior name="pickup" kind="ammo" amount="8"/>
  </Archetype>
  <Archetype name="Treasure" y="0.45" w="0.5" tags="pickup">
    <Sphere color="gold"/><Behavior name="pickup" kind="score" amount="100"/><Behavior name="spin" speed="3"/>
  </Archetype>
  <Archetype name="Exit" y="0.03" w="1.8" h="0.06" d="1.8" tags="exit">
    <Cube color="#22cc44"/>
  </Archetype>

  <!-- ===== Gracz, kamera, świat ===== -->

  <Actor name="Player" y="0.6" w="0.6" h="1.2" d="0.6" ry="-90" vx="0">
    <Collider/>
    <Health hp="100" max="100"/>
    <Behavior name="wolf_player" speed="0.12" turn="3"/>
  </Actor>
  <Actor name="Cam"><Camera mode="fps" target="Player" fov="70"/></Actor>

  <Actor name="Floor" x="23" y="-0.05" z="17" w="48" h="0.1" d="36"><Cube color="#707070"/></Actor>

  <!-- Światło jak w Wolfie: jasne otoczenie + dwa „słońca” z osi X, więc
       ściany wschód/zachód są jaśniejsze niż północ/południe. -->
  <Actor name="Ambient"><Light kind="ambient" color="white" intensity="0.7"/></Actor>
  <Actor name="SunEast" x="1000" z="17"><Light kind="directional" color="white" intensity="0.35"/></Actor>
  <Actor name="SunWest" x="-1000" z="17"><Light kind="directional" color="white" intensity="0.35"/></Actor>

  <Tilemap cell="2">
    <Legend char="#" archetype="Wall"/>
    <Legend char="B" archetype="BlueWall"/>
    <Legend char="D" archetype="Door"/>
    <Legend char="G" archetype="Guard"/>
    <Legend char="+" archetype="Medkit"/>
    <Legend char="a" archetype="AmmoBox"/>
    <Legend char="$" archetype="Treasure"/>
    <Legend char="E" archetype="Exit"/>
    <Legend char="P" actor="Player"/>
    <Map>
      ########################
      #P.....B.......B.......#
      #......B...G...B...$...#
      #..+...D.......D.......#
      #......B.......B...G...#
      #......B...a...B.......#
      #BBDBBBB.......BBBBDBBB#
      #......BBBBBBBBB.......#
      #..G...B.......B...+...#
      #......D...$...D.......#
      #..a...B.......B...G...#
      #BBDBBBB...G...BBBBDBBB#
      #......B.......B.......#
      #..$...BBBBBBBBB...a...#
      #......D...G...D.......#
      #..G...B.......B....E..#
      #......B...+...B.......#
      ########################
    </Map>
  </Tilemap>

  <!-- ===== Stan gry i HUD (space="screen" = piksele ekranu) ===== -->

  <Actor name="Game" w="0" h="0" visible="false">
    <Var name="ammo" value="8"/>
    <Var name="score" value="0"/>
    <Var name="kills" value="0"/>
    <Var name="guards" value="7"/>
    <Var name="hurt" value="0"/>
    <Var name="muzzle" value="0"/>
    <Var name="msgt" value="0"/>
  </Actor>

  <Actor name="Bar" x="400" y="570" w="800" h="60" layer="30" space="screen"><Rect color="#10206a"/></Actor>
  <Actor name="Hud" x="16" y="556" w="0" h="0" layer="40" space="screen">
    <Text value="ŻYCIE {Player.Health.hp}%   AMMO {Game.ammo}   PUNKTY {Game.score}   STRAŻNICY {Game.kills}/{Game.guards}" size="24" color="white"/>
  </Actor>
  <Actor name="Msg" x="16" y="16" w="0" h="0" layer="40" space="screen"><Text value="" size="26" color="gold"/></Actor>
  <Actor name="Gun" x="400" y="500" w="40" h="80" layer="20" space="screen"><Rect color="#4a4a4a"/></Actor>
  <Actor name="GunTip" x="400" y="458" w="18" h="12" layer="21" space="screen"><Rect color="#1e1e1e"/></Actor>
  <Actor name="Muzzle" x="400" y="440" w="46" h="30" layer="22" space="screen" visible="false"><Rect color="orange"/></Actor>
  <Actor name="Crosshair" x="400" y="300" w="4" h="4" layer="20" space="screen"><Rect color="white"/></Actor>
  <Actor name="Flash" x="400" y="300" w="800" h="600" layer="50" space="screen" visible="false"><Rect color="#ff000055"/></Actor>

</Scene>
