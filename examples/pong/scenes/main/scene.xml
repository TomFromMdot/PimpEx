<!-- Pong: left paddle W/S, right paddle arrows. First to 5 points. -->
<Scene background="#0b0b14">

  <Actor name="Line" x="400" y="300" w="4" h="600" layer="-1">
    <Rect color="#2a2a3a"/>
  </Actor>

  <Actor name="Left" x="30" y="300" w="14" h="100">
    <Rect color="#4cc9f0"/>
  </Actor>

  <Actor name="Right" x="770" y="300" w="14" h="100">
    <Rect color="#f72585"/>
  </Actor>

  <Actor name="Ball" x="400" y="300" w="16" h="16" vx="5" vy="2">
    <Circle color="white"/>
  </Actor>

  <!-- Game state: both players' points -->
  <Actor name="Game" w="0" h="0" visible="false">
    <Var name="left" value="0"/>
    <Var name="right" value="0"/>
  </Actor>

  <Actor name="Score" x="340" y="20" w="0" h="0" layer="10" space="screen">
    <Text value="{Game.left}      {Game.right}" size="40" color="white"/>
  </Actor>

  <Actor name="Help" x="190" y="570" w="0" h="0" layer="10" space="screen">
    <Text value="C = play the computer   V = two players" size="16" color="gray"/>
  </Actor>

</Scene>
