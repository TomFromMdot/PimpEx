# Pong – scene logic. Every PROC runs each frame.

PROC paddles
  IF KEY W    : MOVE Left 0 -7
  IF KEY S    : MOVE Left 0 7
  IF KEY UP   : MOVE Right 0 -7
  IF KEY DOWN : MOVE Right 0 7
  IF Left.y < 50   : SET Left.y 50
  IF Left.y > 550  : SET Left.y 550
  IF Right.y < 50  : SET Right.y 50
  IF Right.y > 550 : SET Right.y 550
END

# Bounce off the top and bottom walls
PROC walls
  IF Ball.y < 8 AND Ball.vy < 0   : MUL Ball.vy -1
  IF Ball.y > 592 AND Ball.vy > 0 : MUL Ball.vy -1
END

# Bounce off the paddles – the ball speeds up a little every time
PROC bounces
  IF TOUCH Ball Left AND Ball.vx < 0  : MUL Ball.vx -1.05
  IF TOUCH Ball Left                  : SET Ball.vy RANDOM -5 5
  IF TOUCH Ball Right AND Ball.vx > 0 : MUL Ball.vx -1.05
  IF TOUCH Ball Right                 : SET Ball.vy RANDOM -5 5
END

# A point: the ball got past a paddle
PROC points
  IF Ball.x < 0   : ADD Game.right 1
  IF Ball.x < 0   : CALL serve 1
  IF Ball.x > 800 : ADD Game.left 1
  IF Ball.x > 800 : CALL serve -1
  IF Game.left >= 5  : SCENE game_over
  IF Game.right >= 5 : SCENE game_over
END

# C pastes the computer player from library.swap, V removes it
PROC game_mode
  IF PRESSED C : PROC_ADD computer
  IF PRESSED V : PROC_REMOVE computer
END

# ESC shows the pause menu (gui/pause.xml). The pause itself stops the game.
PROC pause
  IF PRESSED ESCAPE : GUI_SHOW pause
END
