<!-- Pause: ESC in the game shows it (scene.swap); ESC or "Resume" hides it.
     pause="true" stops the ball and the paddles while the pause is visible. -->
<Gui pause="true" dim="#000000aa">
  <Panel  anchor="center" w="360" h="300" color="#1b1b2b" border="#ffffff30"/>
  <Label  anchor="center" y="-95" text="PAUSED" size="48" color="gold"/>
  <Label  anchor="center" y="-50" text="{Game.left} : {Game.right}" size="28" color="white"/>
  <Button anchor="center" y="15" text="Resume" key="ESCAPE" click="GUI_HIDE pause"/>
  <Button anchor="center" y="90" text="Restart" click="SCENE main"/>
</Gui>
